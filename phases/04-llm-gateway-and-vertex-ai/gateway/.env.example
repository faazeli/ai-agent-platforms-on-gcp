# Copy to .env and fill in. Never commit .env.
VERTEX_PROJECT=your-project-id
VERTEX_LOCATION=global
# A long random string; generate one with: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-change-me
# Optional: path to your ADC file if it isn't in the default location
# ADC_FILE=/path/to/application_default_credentials.json
